# --- Server ---
PORT=3000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fleetcore
# true = TypeORM creates/updates tables automatically (development only)
DB_SYNC=true

# --- JWT ---
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1h

# --- API keys for external integrations (comma separated, sent in the x-api-key header) ---
API_KEYS=demo-key-partner-1,demo-key-partner-2

# --- Google OAuth 2.0 (fake values; create real ones at https://console.cloud.google.com) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
